# Password you use to log in at /admin
ADMIN_PASSWORD=change-me

# Optional: separate secret for signing login cookies (any long random string)
SESSION_SECRET=

# Filled in automatically when you connect Upstash Redis in Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Filled in automatically when you connect a Blob store in Vercel → Storage
BLOB_READ_WRITE_TOKEN=


# Recommended: send notifications from your Gmail (needs a Google App password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: where new-ticket alerts go (defaults to GMAIL_USER)
NOTIFY_EMAIL=
